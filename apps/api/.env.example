# PHYZIQ API Environment Variables
# Copy this file to .env and fill in real values

# Main PostgreSQL database (PostgreSQL 16 with pgvector)
DATABASE_URL="postgresql://phyziq_app:your_password@localhost:5432/phyziq_main?schema=public"

# Health Data Store (separate PostgreSQL instance)
HEALTH_DATABASE_URL="postgresql://health_data_svc:your_health_password@localhost:5433/phyziq_health?schema=public"

# Redis (session cache, rate limits, idempotency keys, job queues)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change_me_to_a_512bit_random_secret"
JWT_ACCESS_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="30d"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_your_key_here"
PAYSTACK_PUBLIC_KEY="pk_test_your_key_here"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY="sk-ant-your_key_here"

# Twilio / Africa's Talking (OTP delivery)
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM="+1234567890"

# AWS / Cloudflare R2 (object storage)
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID="your_key"
AWS_SECRET_ACCESS_KEY="your_secret"
S3_BUCKET_NAME="phyziq-exports"

# Google Vision API (food recognition)
GOOGLE_VISION_API_KEY="your_key_here"

# Node environment
NODE_ENV="development"
PORT=3001
