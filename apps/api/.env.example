# PHYZIQ API Environment Variables
# Copy this file to .env and fill in real values

# ── Main Database (Supabase project #1) ─────────────────────────────────────
# Pooler URL (PgBouncer, transaction mode) — used by Prisma at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct connection URL — used by `prisma migrate deploy` and `prisma db push`
# Get this from: Supabase dashboard → Settings → Database → Connection string → URI (direct)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# ── Health Data Store (Supabase project #2 — separate project) ───────────────
# Physical isolation required by Kenya DPA (Req 1.7, 11.2)
# Only HealthDataRepository may use this connection string.
HEALTH_DB_URL="postgresql://postgres.[health-project-ref]:[password]@db.[health-project-ref].supabase.co:5432/postgres"

# ── Redis (session cache, rate limits, idempotency keys, job queues) ─────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change_me_to_a_512bit_random_secret"
JWT_ACCESS_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_your_key_here"
PAYSTACK_PUBLIC_KEY="pk_test_your_key_here"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"

# ── Anthropic (Claude 3.5 Sonnet) ─────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-your_key_here"

# ── Twilio / Africa's Talking (OTP delivery) ──────────────────────────────────
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM="+1234567890"

# ── Object Storage (AWS S3 or Cloudflare R2) ──────────────────────────────────
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID="your_key"
AWS_SECRET_ACCESS_KEY="your_secret"
S3_BUCKET_NAME="phyziq-exports"

# ── Google Vision API (food recognition) ──────────────────────────────────────
GOOGLE_VISION_API_KEY="your_key_here"

# ── Node environment ───────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
